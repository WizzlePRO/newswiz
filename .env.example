# Postgres connection used by the web app, the ingest worker, and migrations.
DATABASE_URL=postgres://newswiz:newswiz@localhost:5432/newswiz

# Only used by `pnpm test`. Tests wipe this database, so never point it at real data.
TEST_DATABASE_URL=postgres://newswiz:newswiz@localhost:5432/newswiz_test

# Optional single-user passphrase. Leave empty to disable the login screen
# (fine on a home network; set it before exposing the app to the internet).
APP_PASSPHRASE=

# Your time zone for times like "Since Tue 7:40 AM" (IANA name). Defaults to the server's zone.
APP_TIMEZONE=America/New_York

# Sent with every feed request so publishers can see who is fetching and reach you.
# Put a real contact URL or email here.
INGEST_CONTACT=https://github.com/your-name/newswiz

# How many feeds the worker fetches at once (one at a time per domain regardless).
INGEST_CONCURRENCY=6
